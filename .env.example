# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Groq API Key for instant Whisper voice recognition (free from https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional: Specific Conversation ID to bind to. If empty, the bridge automatically connects to the most active session.
ANTIGRAVITY_CONVERSATION_ID=

# Optional: Allowed Telegram User ID (first user to send /start will be automatically registered if left blank)
ALLOWED_CHAT_ID=
