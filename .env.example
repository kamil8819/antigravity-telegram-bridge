# ==========================================
# Antigravity Telegram Bridge Configuration
# ==========================================

# 1. Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# 2. Google Gemini API Key (Required for Live Voice Full-Duplex & Gemini STT)
# Get free API key from https://aistudio.google.com
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# 3. Groq API Key (Fast Whisper-large-v3 voice recognition in ~0.3s)
# Get free API key from https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# 4. Access Control (Optional)
# Leave blank to allow first user who sends /start, or specify your numeric Telegram ID
ALLOWED_CHAT_ID=

# 5. Session Pinning (Optional)
# Specific Antigravity Conversation ID. Leave blank to auto-track the newest active session
ANTIGRAVITY_CONVERSATION_ID=

# 6. Live Voice Settings (Optional)
LIVE_VOICE_PORT=8765
LIVE_VOICE_HOST=127.0.0.1

# 7. Network & Proxy Settings (Optional)
# If you are in a restricted network, specify your local proxy (e.g. SOCKS5 or HTTP)
# HTTPS_PROXY=http://127.0.0.1:10809
# ALL_PROXY=socks5://127.0.0.1:10808

# 8. Remote VPS Tunnel for Mini App (Optional)
# If using a remote VPS for Cloudflare Tunnel:
# SSH_TUNNEL_HOST=user@vps.example.com
